[Unit]
Description=Knowledge Forge private query and curation API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=kf-query
Group=kf-query
SupplementaryGroups=kf-services kf-readers kf-curators
EnvironmentFile=/etc/hermes-connaissance/query.env
ExecStart=/srv/hermes-connaissance/bin/knowledge-forge serve
WorkingDirectory=/srv/hermes-connaissance
Restart=on-failure
RestartSec=5
UMask=0007
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/hermes-connaissance/data
ReadWritePaths=/run/hermes-connaissance
InaccessiblePaths=/srv/hermes-connaissance/postgres /var/lib/knowledge-forge-ingest /etc/hermes-connaissance/ingest.env /etc/hermes-connaissance/migrator.env /etc/hermes-connaissance/backup.env /etc/hermes-connaissance/postgres-admin.password /etc/hermes-connaissance/restic-password /etc/hermes-connaissance/restic-secrets-password
MemoryHigh=8G
MemoryMax=9G
CPUQuota=200%
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
